# ==============================================================================
# GovSecure Environment Variables
# Copy this file to .env and fill in the values before running.
# Never commit real credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# LOG_CONSOLE=true will force Winston console logs even in production (good for Render)
LOG_CONSOLE=true

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Long random string used for signing JWTs + deriving AES keys.
# On Render you can use the "generate value" button or run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-secret-string

# ------------------------------------------------------------------------------
# Database (SQLite - path on filesystem)
# For Docker / Render mounted volumes keep this under /usr/src/app/data/
# ------------------------------------------------------------------------------
DATABASE_PATH=./data/database.sqlite

# ------------------------------------------------------------------------------
# Email (SMTP via Gmail — for OTP emails)
# For Gmail create an App Password at:
#   https://myaccount.google.com/apppasswords
# Leave blank to skip real email sending (you'll see warnings but login still works)
# ------------------------------------------------------------------------------
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ------------------------------------------------------------------------------
# SMS (Twilio — for login 2FA & Aadhaar OTP via SMS)
# Leave blank to use simulated SMS (OTPs logged to server console instead of sent).
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# Redis (optional cache layer)
# If not provided the app will gracefully fall back to an in-memory Map.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# File Storage
# Default: "local" (filesystem under ./uploads)
# Alternative: "s3" (requires the AWS vars below)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local

# AWS S3 (only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=govsecure-vault
